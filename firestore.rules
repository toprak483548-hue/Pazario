rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    // IMPORTANT: Replace the placeholder with your own UID before enabling admin moderation.
    function isAdmin() {
      return signedIn() && request.auth.uid in ['REPLACE_WITH_YOUR_ADMIN_UID'];
    }
    function validListingShape(d) {
      return d.keys().hasOnly([
        'title','description','price','categoryId','subcategory','listingType','condition',
        'city','district','sellerType','negotiable','shipping','photos','attributes',
        'ownerId','ownerName','status','createdAt','updatedAt','publishedAt','moderationNote'
      ])
      && d.title is string && d.title.size() >= 8 && d.title.size() <= 100
      && d.description is string && d.description.size() >= 20 && d.description.size() <= 5000
      && d.price is number && d.price >= 0 && d.price <= 999999999
      && d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 50
      && d.city is string && d.city.size() > 0 && d.city.size() <= 40
      && d.district is string && d.district.size() <= 70
      && d.listingType is string && d.listingType.size() <= 40
      && d.condition is string && d.condition.size() <= 30
      && d.sellerType is string && d.sellerType.size() <= 20
      && d.ownerId is string && d.ownerName is string && d.ownerName.size() <= 70
      && d.photos is list && d.photos.size() <= 5
      && d.attributes is map
      && d.negotiable is bool && d.shipping is bool;
    }

    match /listings/{listingId} {
      allow read: if (resource.data.status == 'published')
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      allow create: if verified()
        && validListingShape(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('publishedAt' in request.resource.data)
        && !('moderationNote' in request.resource.data);

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == 'pending'
          && validListingShape(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title','description','price','categoryId','subcategory','listingType','condition',
            'city','district','sellerType','negotiable','shipping','photos','attributes','updatedAt','status'
          ]));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','phone','city','createdAt','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.city is string && request.resource.data.city.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','phone','city','createdAt','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.city is string && request.resource.data.city.size() <= 40
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /favorites/{listingId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['listingId','createdAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'published';
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
      match /savedSearches/{searchId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name','filters','createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.filters is map
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds;
      }
      allow read: if isParticipant() || isAdmin();
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'listingId','listingTitle','buyerId','buyerName','ownerId','ownerName','participantIds','lastMessage','createdAt','updatedAt'
        ])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerName is string && request.resource.data.buyerName.size() >= 2 && request.resource.data.buyerName.size() <= 70
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() >= 2 && request.resource.data.ownerName.size() <= 70
        && request.resource.data.listingTitle is string && request.resource.data.listingTitle.size() <= 100
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.ownerId in request.resource.data.participantIds
        && request.resource.data.listingId is string
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'published'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.ownerId
        && request.resource.data.createdAt == request.time;
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000;
      allow delete: if false;

      match /messages/{messageId} {
        function parentParticipant() {
          return signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
        allow read: if parentParticipant() || isAdmin();
        allow create: if verified() && parentParticipant()
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['listingId','reporterId','reason','details','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 80
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
